# Copy this file to .env and change every value marked CHANGE.
# The real .env file must never be committed.

# --- Django ---
SECRET_KEY=CHANGE-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Minutes of inactivity before a signed-in session expires (NFR-04)
SESSION_IDLE_MINUTES=30
# The time zone shown on screen and used for report days. South African time unless you change it.
TIME_ZONE=Africa/Johannesburg

# --- Database (PostgreSQL container defined in docker-compose.yml) ---
POSTGRES_DB=hpcsentinel
POSTGRES_USER=hpcsentinel
POSTGRES_PASSWORD=CHANGE-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Data source ---
# Address of the facility's Prometheus server, as seen from inside the containers.
PROMETHEUS_URL=http://host.docker.internal:9090

# --- Platform settings ---
HPCSENTINEL_CONFIG=config/hpcsentinel.yml
MODEL_STORE=/app/model_store

# --- Where the web page listens ---
# 127.0.0.1 = this machine only (use this behind Apache). To open the page from another computer, put the
# address of this machine on the network you use (for example its Tailscale address), or 0.0.0.0 for all of them.
WEB_BIND=127.0.0.1

# --- Reverse proxy (only when served under a path such as /sentinel) ---
FORCE_SCRIPT_NAME=
BEHIND_PROXY=false
CSRF_TRUSTED_ORIGINS=

# --- Email alerts (optional) ---
# Leave EMAIL_HOST empty to send no email. Recipients are set on the Settings page, not here.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=the address, EMAIL_HOST_PASSWORD=a 16-character
# app password (Google account > Security > 2-Step Verification > App passwords), never the account's own password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# The "From" address. Empty: the same as EMAIL_HOST_USER.
EMAIL_FROM=
# Public address of this site, for the links in emails. Empty: emails have no links.
SITE_URL=
